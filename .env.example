# -------------------------------------------------------------
# CivicLens — Environment Configuration Example
# Copy this file to .env and adjust values for your local setup.
# DO NOT commit real secrets or credentials to GitHub!
# -------------------------------------------------------------

# Application
APP_NAME=CivicLens
APP_TAGLINE="Report. Track. Resolve."
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/CivicLens
APP_TIMEZONE=Asia/Kolkata

# Database (MySQL / MariaDB via XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=civiclens_db
DB_USER=root
DB_PASS=

# Anonymous Complaint Fee (₹)
ANONYMOUS_COMPLAINT_FEE=9

# Authority Subscription Fee (₹ per year)
AUTHORITY_SUBSCRIPTION_PRICE=5000

# Razorpay Payment Gateway (Test Mode)
# Leave empty if testing without live Razorpay API; the UI will cleanly show test-mode disabled status.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Notification Channels (In-App is always active in database)
MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@civiclens.local

SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_API_KEY=

# Initial Administrator Secure Creation Token (Used during setup_admin.php)
ADMIN_SETUP_SECRET=ChangeThisToAStrongSecretBeforeRunningSetup
